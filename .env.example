# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real values.
# The project is not deployed anywhere (AUDIT_REPORT.md Decision D-03).

# --- Core -------------------------------------------------------------------
# "True" only for local development. Production must run with DEBUG=False.
DEBUG=True

# Required when DEBUG=False (startup fails without it, or if it starts with
# "django-insecure-" / is shorter than 50 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Local default: a SQLite file in the project. Do NOT point local dev or tests
# at the hosted database. Postgres example:
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skillstudio
DATABASE_URL=sqlite:///db.sqlite3

# --- Origins ------------------------------------------------------------------
# Comma-separated full origins, including scheme (only if a separate frontend
# origin ever needs cookie/CORS access; not needed for local development).
# CSRF_TRUSTED_ORIGINS=
# CORS_ALLOWED_ORIGINS=
# Public base URL used in certificate QR / verification links.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# --- Background jobs (optional; no tasks use Celery yet) --------------------
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Stripe (planned; TEST MODE ONLY for the demo — see AUDIT_REPORT.md SEC-01)
# STRIPE_TEST_MODE=True
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
